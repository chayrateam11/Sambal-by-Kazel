# ==============================================================================
# SAMBAL BY KAZEL - ENVIRONMENT VARIABLES CONFIGURATION (CLOUDFLARE PAGES)
# ==============================================================================
# Petunjuk:
# 1. Untuk deployment Cloudflare Pages: Daftarkan variabel berikut di menu:
#    Dashboard Cloudflare > Workers & Pages > Sambal by Kazel > Settings > Environment Variables.
# 2. Untuk pengujian lokal dengan Wrangler: Salin file ini menjadi `.dev.vars` (JANGAN pernah commit .dev.vars ke Git).
# ==============================================================================

# URL Web App Google Apps Script (Wajib - Private Backend Endpoint)
# Dihasilkan dari Deploy as Web App di Google Sheets script editor.
GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec

# PIN Keamanan Administrator Dashboard (Wajib)
# Digunakan untuk login ke /admin. Ganti dengan PIN rahasia 6-8 digit Anda.
ADMIN_PIN=202688

# Secret Key untuk Tanda Tangan Kriptografi Token Sesi Admin (Wajib)
# String acak yang panjang dan aman untuk HMAC-SHA256 session token generation.
AUTH_SECRET=sambal_by_kazel_secure_hmac_secret_key_change_in_production_2026

# Origin Resmi Domain Produksi (Opsional - default: https://sambal.chayrawellness.com)
ALLOWED_ORIGIN=https://sambal.chayrawellness.com

# Konfigurasi Payment Gateway Midtrans (Opsional - jika fitur payment gateway diaktifkan)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
IS_PRODUCTION=false

# Konfigurasi Payment Gateway Xendit (Opsional - alternatif jika menggunakan Xendit)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx
